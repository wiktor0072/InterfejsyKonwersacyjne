# Hotel Aurora - Environment Variables
# Skopiuj ten plik jako .env i uzupełnij wartości

# Groq API (wymagane dla LLM)
# Uzyskaj klucz: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ElevenLabs API (opcjonalne - dla TTS)
# Uzyskaj klucz: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Cloud Speech credentials są w pliku gcp_key.json
# (nie jako zmienna środowiskowa)
